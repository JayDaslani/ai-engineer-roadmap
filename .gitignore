# ==========================================
# Secret Keys & Environment Variables (CRITICAL)
# ==========================================
.env
*.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
*.secret.json

# ==========================================
# Virtual Environments (Nested & Root)
# ==========================================
